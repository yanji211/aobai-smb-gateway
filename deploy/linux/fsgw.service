[Unit]
Description=家庭共享网关 fsgw（SMB + DLNA + WebDAV）
Documentation=file:///etc/fsgw/config.yaml
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fsgw run -config /etc/fsgw/config.yaml -notray
WorkingDirectory=/var/lib/fsgw
Restart=on-failure
RestartSec=3
# 进程被 systemd 停止时，Quit() 仍会执行：拆 SMB/DLNA/WebDAV 后再退
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
